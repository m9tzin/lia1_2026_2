{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lia.passaporte/v1",
  "title": "Passaporte de modelo ONNX",
  "description": "Contrato que descreve como executar e interpretar um modelo ONNX, gravado em metadata_props na chave lia.passaporte.",
  "type": "object",
  "required": ["versao", "nome", "tarefa", "classes", "entrada", "saida", "operacao"],
  "additionalProperties": false,
  "properties": {
    "versao": { "const": 1 },
    "nome": { "type": "string", "minLength": 1 },
    "descricao": { "type": "string" },
    "tarefa": { "enum": ["deteccao", "classificacao"] },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "entrada": {
      "type": "object",
      "required": ["tensor", "layout", "tamanho", "cores", "redimensionar", "escala", "media", "desvio"],
      "additionalProperties": false,
      "properties": {
        "tensor": { "type": "string" },
        "layout": { "enum": ["NCHW", "NHWC"] },
        "tamanho": {
          "description": "[altura, largura] em pixels",
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "cores": { "enum": ["RGB", "BGR"] },
        "redimensionar": { "enum": ["letterbox", "esticar", "recorte_central"] },
        "preenchimento": { "type": "integer", "minimum": 0, "maximum": 255 },
        "escala": { "type": "number", "exclusiveMinimum": 0 },
        "media": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "desvio": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "saida": {
      "type": "object",
      "required": ["tensor", "formato"],
      "additionalProperties": false,
      "properties": {
        "tensor": { "type": "string" },
        "formato": {
          "enum": ["caixas_xywh_por_classe", "caixas_xyxy_conf_classe", "probabilidades", "logits"]
        }
      }
    },
    "operacao": {
      "type": "object",
      "required": ["confianca_minima"],
      "additionalProperties": false,
      "properties": {
        "confianca_minima": { "type": "number", "minimum": 0, "maximum": 1 },
        "iou_nms": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotulo_incerto": { "type": "string" }
      }
    },
    "decisao": {
      "type": "object",
      "required": ["alertar_se", "limiar_alerta", "mensagem"],
      "additionalProperties": false,
      "properties": {
        "alertar_se": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "limiar_alerta": { "type": "number", "minimum": 0, "maximum": 1 },
        "zona_incerta": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "mensagem": { "type": "string" }
      }
    },
    "origem": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "framework": { "type": "string" },
        "pesos": { "type": "string" },
        "dataset": { "type": "string" },
        "best": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "epoca": { "type": "integer" },
            "mAP50": { "type": "number" },
            "mAP50_95": { "type": "number" },
            "fitness": { "type": "number" }
          }
        },
        "exportado_em": { "type": "string" }
      }
    }
  }
}
